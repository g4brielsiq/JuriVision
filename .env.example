# ==============================================================================
# JuriVision — Plataforma de Jurimetria Preditiva - Variáveis de Ambiente
# ==============================================================================
# ATENÇÃO: Este arquivo contém apenas valores de exemplo para ambiente local.
# NÃO utilize credenciais reais ou senhas de produção neste arquivo.
# ==============================================================================

# PostgreSQL (ADR-003: Persistência Relacional com fallback em SQLite se offline)
POSTGRES_DB=jurimetria
POSTGRES_USER=jurimetria_dev
POSTGRES_PASSWORD=change_me_locally
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend API Core
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET_KEY=change_me_jwt_secret_local_jurivision_2026
JWT_EXPIRATION_MINUTES=480

# AI Engine (Microsserviço Isolado — ADR-001 e ADR-002)
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_PORT=8001
AI_ENGINE_URL=http://ai_engine:8001
# Opções de AI_PROVIDER:
# - "local": motor heurístico/estatístico determinístico local (padrão, offline e custo zero)
# - "gemini": Google AI Studio (Free Tier - Gemini 2.5 Flash) com barreira LGPD
# - "auto": usa Gemini se GEMINI_API_KEY estiver configurada, senão fallback local
# - "external": microsserviço ai_engine na rede Docker
AI_PROVIDER=local

# Google AI Studio (Gemini Free Tier - R$ 0,00)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=4.0

# DataJud (API Pública do CNJ / TJAL)
DATAJUD_API_KEY=cDZHYUpZwHbBoikSmFtUtqQCFlPqzqMV
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
DATAJUD_TIMEOUT_SECONDS=3.0
DATAJUD_DEFAULT_ALIAS=api_publica_tjal

# Frontend
FRONTEND_PORT=5173
