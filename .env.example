# ==============================================================================
# JuriVision — Plataforma de Jurimetria Preditiva - Variáveis de Ambiente
# ==============================================================================
# ATENÇÃO: Este arquivo contém apenas valores de exemplo para ambiente local.
# NÃO utilize credenciais reais ou senhas de produção neste arquivo.
# ==============================================================================

# PostgreSQL (ADR-003: Persistência Relacional com fallback em SQLite se offline)
POSTGRES_DB=jurimetria
POSTGRES_USER=jurimetria_dev
POSTGRES_PASSWORD=change_me_locally
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend API Core
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET_KEY=change_me_jwt_secret_local_jurivision_2026
JWT_EXPIRATION_MINUTES=480

# AI Engine (Microsserviço Isolado — ADR-001 e ADR-002)
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_PORT=8001
AI_ENGINE_URL=http://ai_engine:8001
# Opções de AI_PROVIDER:
# - "local": motor heurístico/estatístico determinístico local (padrão, offline e custo zero)
# - "gemini": Google AI Studio (Free Tier - Gemini Flash / Flash-Lite) com barreira LGPD
# - "auto": usa Gemini se GEMINI_API_KEY estiver configurada, senão fallback local
# - "external": microsserviço ai_engine na rede Docker
AI_PROVIDER=local

# Google AI Studio (Gemini Free Tier - R$ 0,00)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20.0

# DataJud (API Pública do CNJ / TJAL)
# Chave pública vigente: https://datajud-wiki.cnj.jus.br/api-publica/acesso (o CNJ pode trocá-la a qualquer momento).
# A API costuma levar dezenas de segundos sob carga; timeouts curtos fazem toda consulta falhar.
DATAJUD_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
DATAJUD_TIMEOUT_SECONDS=60.0
DATAJUD_DEFAULT_ALIAS=api_publica_tjal

# Frontend e Deploy Cloud / Freemium
FRONTEND_PORT=5173
SERVE_FRONTEND_STATIC=false
FREE_PLAN_PDF_LIMIT=3
# Dados fictícios de demonstração (opt-in). Mantenha false para iniciar com base vazia,
# como um usuário real. Use true apenas em apresentações locais.
SEED_DEMO_DATA=false
